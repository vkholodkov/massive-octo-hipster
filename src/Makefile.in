AR=@AR@
CC=@CC@
LD=@CC@
INCLUDES=-I..
CFLAGS=$(INCLUDES) @CFLAGS@
LDFLAGS=@LDFLAGS@
LIBS=@LIBS@
OBJS=pool.o symtab.o string.o list.o bootstrap.o vector.o grammar.o output.o lookahead.o trie.o lookup.o
MOH_OBJS=main.o
MOH=moh
DEPS=.deps

all: $(MOH)

$(MOH): $(MOH_OBJS) $(OBJS)
	@echo "Linking $@"
	$(CC) $^ -o $@ $(CDFLAGS) $(LDFLAGS) $(LIBS)

%.o:	%.c
	$(CC) $(CFLAGS) -c -o $@ $<

%.d:	%.c
	gcc -M -MF$@ $(CFLAGS) $<

clean:
	rm -f core $(OBJS) $(MOH_OBJS) $(MOH)

distclean: clean
	rm -f $(DEPS) $(patsubst %.o,%.d,$(OBJS))

depend: $(patsubst %.o,%.d,$(OBJS))
	cat $^ > $(DEPS)

-include .deps

